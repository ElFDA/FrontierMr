@@ -24,6 +24,9 @@ module console_out
 	input       [9:0] hc,
 	input       [9:0] vc,
 	input       [9:0] height,
+	input             fld,    // interlaced: field being drawn (0 even rows, 1 odd rows)
+	input             il,     // interlaced: fb_height is the frame, height the lines per field
+	input       [9:0] hhalf,  // hc at which the odd field starts (half line)
 	output reg [23:0] rgb,
 	output reg        active = 0
 );
@@ -42,11 +45,11 @@ always @(posedge clk_vid) begin
 	h      <= fb_height;
 	out_h  <= height;
