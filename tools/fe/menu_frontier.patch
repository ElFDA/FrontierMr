 	show_s <= {show_s[0], show};
-	active <= show_s[1] && fmt[2:0] == 3'b110 && w && h && w <= WIDTH && h <= out_h;
+	active <= show_s[1] && fmt[2:0] == 3'b110 && w && h && w <= WIDTH && lines <= out_h;
 end
 
 reg       req_t = 0;
@@ -56,10 +59,12 @@ reg       req_bank;
 always @(posedge clk_vid) begin
 	reg [9:0] ny;
 
-	if(ce_pix && !hc && active && (vc + 1'd1 < out_h || vc == out_h)) begin
+	// the odd field starts on its half line (hc == hhalf), where hc does not wrap
+	if(ce_pix && (fld && !vc ? hc == hhalf : !hc) && active && (vc + 1'd1 < out_h || vc == out_h)) begin
 		ny = (vc == out_h) ? 10'd0 : vc + 1'd1;
 		if(ny >= top && ny - top < lines) begin
-			req_line <= ny - top;
+			// interlaced: row 2*line + field of the frame (the next field when ny wraps to 0)
+			req_line <= il ? {ny[8:0] - top[8:0], (vc == out_h) ? ~fld : fld} : ny - top;
 			req_bank <= ny[0];
 			req_t    <= ~req_t;
 		end
